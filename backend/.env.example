# Which provider to use for the live voice+drawing session.
# gemini = Gemini Live API (implemented). openai = OpenAI Realtime API (stub, not implemented yet).
PROVIDER=gemini

# --- Gemini ---
GEMINI_API_KEY=your_google_ai_studio_key_here
# gemini-3.1-flash-live-preview  -> newest, function calls are synchronous only
# gemini-2.5-flash-live-preview  -> supports NON_BLOCKING/async function calling, slightly older
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# --- OpenAI (not wired up yet, placeholder for when openaiProvider.js is filled in) ---
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# --- Server ---
PORT=8080